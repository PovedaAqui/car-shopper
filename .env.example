# Local / deployment secrets — never commit real values.

# Convex
CONVEX_URL=http://127.0.0.1:3210
CONVEX_SITE_URL=http://127.0.0.1:3211
WORKER_API_KEY=

# Local models
MODEL_BASE_URL=http://localhost:8000/v1
MODEL_NAME=qwen38-27b-unsloth-nvfp4-dflash2
# VISION_MODE only governs whether the SECONDARY vision provider (see
# VISION_PROVIDER below) may be used when the primary one is unhealthy or
# not vision-capable: local_inference_only (default) = never use the other
# provider automatically; local_preferred = allow it. It does not block the
# primary provider itself, so with VISION_PROVIDER=openai (the default)
# OpenAI vision is contacted normally even in local_inference_only mode.
VISION_MODE=local_inference_only
MODEL_IS_VISION=0

# Vision provider selection. DEFAULT is "openai" — the local model above is
# used only for text extraction unless VISION_PROVIDER=local is set. Set
# VISION_PROVIDER=local to make the local vLLM/Ollama/LM Studio model the
# vision provider instead (requires MODEL_IS_VISION=1 on a vision-capable
# served model).
VISION_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Text-extraction provider selection (repairs price/km when the deterministic
# regex parse can't find them on a card — reads only that card's own text,
# never invents a number). DEFAULT is "openai". Set TEXT_PROVIDER=local to
# use the local model above instead.
TEXT_PROVIDER=openai
OPENAI_TEXT_MODEL=gpt-4o-mini

# Default photos-per-ad cap for vision (and photo fetch) when a job doesn't
# set its own maxPhotos. 1 = analyze only the first photo (fast, cheap);
# 0 = vision off entirely; override per job via the frontend Settings
# dialog / maxPhotos criteria field.
VISION_MAX_PHOTOS_PER_CAR=1

# AgentMail (set via `npx convex env set`, not in git)
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=
AGENTMAIL_WEBHOOK_SECRET=
