# Local / deployment secrets — never commit real values.

# Convex
CONVEX_URL=http://127.0.0.1:3210
CONVEX_SITE_URL=http://127.0.0.1:3211
WORKER_API_KEY=

# Local models
MODEL_BASE_URL=http://localhost:8000/v1
MODEL_NAME=qwen38-27b-unsloth-nvfp4-dflash2
VISION_MODE=local_inference_only
MODEL_IS_VISION=0

# Optional cloud vision fallback (used only when VISION_MODE=local_preferred
# AND the local model is down or not vision-capable). Never used silently in
# local_inference_only mode.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# AgentMail (set via `npx convex env set`, not in git)
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=
AGENTMAIL_WEBHOOK_SECRET=
